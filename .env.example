# Copy this file to .env and fill in your real values.
# Never commit the actual .env file.

# Groq API key — get one at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (see README > Notes on the LLM model)
GROQ_MODEL=openai/gpt-oss-120b

# JWT signing secret for the FastAPI backend. MUST be changed to a long
# random value before any real deployment - generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=dev-insecure-secret-change-me

# MySQL connection details
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=project_data
